#!/usr/bin/env bash
# Runs the Rust CLI from anywhere, building it first if needed.
#   ln -sf "$PWD/scripts/vs" ~/.local/bin/vs
set -euo pipefail
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"; SCRIPT="$(readlink "$SCRIPT")"; [[ "$SCRIPT" != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
BIN="$ROOT/target/release/vs"
if [ ! -x "$BIN" ] || [ -n "$(find "$ROOT/crates" -newer "$BIN" -name '*.rs' -print -quit)" ]; then
  (cd "$ROOT" && cargo build --release --quiet)
fi
[ -d "$ROOT/studio/node_modules" ] || (cd "$ROOT/studio" && npm install --no-audit --no-fund)
export VS_ROOT="$ROOT"
exec "$BIN" "$@"
